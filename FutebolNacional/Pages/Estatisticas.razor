@page "/estatisticas"
@using FutebolNacional.Models
@inject IHttpClientFactory ClientFactory


<style>
    .barra-container {
        height: 12px;
        background-color: #e9ecef;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 4px;
    }

    .barra-feita {
        background-color: #28a745;
        transition: width 1s;
    }

    .barra-sofrida {
        background-color: #dc3545;
        transition: width 1s;
    }

    .sigla-clube {
        width: 50px;
        font-weight: bold;
        color: #333;
    }

    .saldo-card {
        min-width: 50px;
        font-weight: bold;
        text-align: center;
        border-radius: 4px;
        padding: 5px;
    }

    /* Força o cabeçalho 'Saldo' a alinhar com o card à direita */
    .col-saldo-header {
        width: 100px;
        text-align: center;
    }

    .col-saldo-body {
        width: 100px;
    }

    /* Container da barra com cor de fundo mais visível */
    .barra-bg {
        background-color: #eee;
        border-radius: 10px;
        height: 12px;
        width: 100%;
        position: relative;
    }

    .chevron-icon {
        transition: transform 0.3s ease;
        color: #adb5bd;
    }

    .chevron-rotated {
        transform: rotate(180deg);
        color: #198754; /* Muda para verde quando aberto */
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-center justify-content-center bg-light p-3 p-md-4 mb-4 rounded shadow-sm"
     style="border-left: 8px solid #005c2d; border-right: 8px solid #f9dd16;">

    <!-- Logo: Ajustado o tamanho para mobile e margem responsiva -->
    <img src="img/escudos/brasileiro.png" alt="Logo Brasileirão"
         class="mb-3 mb-md-0 me-md-4"
         style="height: 60px; max-height: 80px; width: auto;" />

    <div class="text-center text-md-start">
        <h2 class="fw-bold mb-1" style="color: #004a29; letter-spacing: 1px; font-size: calc(1.2rem + 0.6vw);">
            CAMPEONATO BRASILEIRO
        </h2>

        <!-- Temporadas Dinâmicas -->
        <div class="d-flex flex-wrap justify-content-center justify-content-md-start">
            <span class="badge bg-dark text-white text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px; white-space: normal;">
                Temporadas @(string.IsNullOrEmpty(temporadasDisponiveisStr) ? "..." : temporadasDisponiveisStr)
                @*Temporadas 2022 • 2023 • 2024*@
            </span>
        </div>
    </div>
</div>

<div class="container mt-4">
    <!-- Removido o justify-content-between para não forçar os itens para as pontas -->
    <div class="d-flex flex-column mb-4 gap-2">
        <!-- text-nowrap evita que o título quebre em duas linhas se houver espaço -->
        <h3 class="fw-bold mb-0 text-nowrap">📊 Estatísticas de Gols</h3>
        <!-- No mobile o select ocupa 100% (w-100), no desktop volta a ser pequeno (w-md-25) -->
        <div style="max-width: 220px;">
            <label class="form-label fw-bold small text-muted mb-1 d-block">TEMPORADA</label>
            <select class="form-select shadow-sm border-2" @onchange="MudarAno">
                <option value="2024">Temporada 2024</option>
                <option value="2023">Temporada 2023</option>
                <option value="2022">Temporada 2022</option>
            </select>
        </div>
    </div>

    @if (carregando)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-success">
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white shadow-sm rounded p-3">

            <!-- Bloco do Pódio com Verificação -->
            <div class="row mb-5 text-center animate__animated animate__fadeIn">
                <div class="col-12">
                    <h4 class="fw-bold mb-4">🏆 Top 5 Artilheiros - @anoSelecionado</h4>
                </div>

                @if (topArtilheiros != null && topArtilheiros.Any())
                {
                    @foreach (var (art, index) in topArtilheiros.Select((value, i) => (value, i)))
                    {
                        <div class="col-md-2 @(index == 0 ? "offset-md-1" : "")">
                            <div class="card border-0 shadow-sm p-3 h-100 position-relative"
                                 style="border-bottom: 4px solid @(index == 0 ? "#ffd700" : index == 1 ? "#c0c0c0" : index == 2 ? "#cd7f32" : "#eee") !important;">

                                <div class="position-absolute top-0 start-50 translate-middle-y bg-white rounded-circle shadow-sm" style="width:40px; height:40px; line-height:40px;">
                                    @(index == 0 ? "🥇" : index == 1 ? "🥈" : index == 2 ? "🥉" : (index + 1) + "º")
                                </div>

                                <img src="img/escudos/@(art.Time).png" width="30" class="mx-auto mb-2 mt-2" />
                                <h6 class="mb-1 fw-bold text-truncate">@art.Nome</h6>
                                <div class="badge bg-dark text-white fw-bold px-2 py-1">@art.Gols Gols</div>
                            </div>
                        </div>} }
                else
                { <!-- MENSAGEM QUANDO NÃO HÁ DADOS -->
                    <div class="col-12">
                        <div class="alert alert-light border shadow-sm d-inline-block p-4">
                            <i class="fas fa-info-circle text-primary mb-2 d-block" style="font-size: 1.5rem;"></i>
                            <span class="text-muted">Os dados detalhados de artilharia para a temporada <strong>@anoSelecionado</strong> ainda não foram processados.</span>
                        </div>
                    </div>}
            </div>

            <table class="table align-middle" ; width: 100%;">
                <thead>
                    <tr class="text-muted small text-uppercase border-bottom">
                        <!-- Coluna Clube: min-width garante que o texto não esmague o ícone de sort -->
                        <th style="min-width: 100px; cursor: pointer;" @onclick='() => Ordenar("Nome")' class="py-3">
                            <span class="d-none d-md-inline">CLUBE</span>
                            <span class="d-md-none">TIME</span>
                            <i class="fas fa-sort ms-1" style="font-size: 0.7rem;"></i>
                        </th>

                        <!-- Coluna Desempenho: Ocupa o maior espaço. text-nowrap evita quebra de linha -->
                        <th style="cursor: pointer;" @onclick='() => Ordenar("Gols")' class="py-3 text-nowrap">
                            <span class="d-none d-md-inline">DESEMPENHO DE GOLS</span>
                            <span class="d-md-none">GOLS</span>
                            <i class="fas fa-sort ms-1" style="font-size: 0.7rem;"></i>
                        </th>

                        <!-- Coluna Saldo: Ajustada para alinhar com o card de 55px que criamos no corpo -->
                        <th style="width: 70px; cursor: pointer;" @onclick='() => Ordenar("Saldo")' class="text-center py-3">
                            SALDO <i class="fas fa-sort ms-1" style="font-size: 0.7rem;"></i>
                        </th>
                    </tr>
                </thead>

                <tbody class="align-middle">
                    @foreach (var clube in listaRanking)
                    {
                    <tr>
                        <!-- Coluna 1: Nome/Sigla (Largura adaptável) -->
                        <td style="min-width: 100px; cursor: pointer;" @onclick="() => clube.ExibirDetalhes = !clube.ExibirDetalhes">
                            <div class="d-flex align-items-center">
                                <span class="me-1 d-none d-sm-inline">
                                    <!-- Esconde medalha em telas minúsculas para ganhar espaço -->
                                    @if (listaRanking.IndexOf(clube) == 0)
                                        {<span>🥇</span> }
                                        else if (listaRanking.IndexOf(clube) == 1)
                                        { <span>🥈</span> }
                                        else if (listaRanking.IndexOf(clube) == 2)
                                        { <span>🥉</span>}
                                </span>
                                <img src="img/escudos/@(clube.Nome).png" width="22" class="me-1 me-md-2" />
                                <span class="fw-bold small">@clube.Sigla</span>
                                <i class="fas fa-chevron-down ms-auto @(clube.ExibirDetalhes ? "chevron-rotated" : "")" style="font-size: 0.7rem;"></i>
                            </div>
                        </td>

                        <!-- Coluna 2: Barras (Ocupa o resto do espaço) -->
                        <td class="px-2 px-md-3" style="width: 100%;">
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small fw-bold mb-1" style="color: #157347; font-size: 0.7rem;">
                                    <span>Gols Feitos:</span> <span>@clube.GolsFeitos</span>
                                </div>
                                <div class="barra-bg" style="background-color: #eee; height: 8px; border-radius: 4px; overflow: hidden;">
                                    <div style="width: @(clube.GetPorcentagemFeitos(totalGolsCampeonato).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; background-color: #28a745; height: 100%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small fw-bold mb-1" style="color: #bb2d3b; font-size: 0.7rem;">
                                    <span>Sofridos:</span> <span>@clube.GolsSofridos</span>
                                </div>
                                <div class="barra-bg" style="background-color: #eee; height: 8px; border-radius: 4px; overflow: hidden;">
                                    <div style="width: @(clube.GetPorcentagemSofridos(totalGolsCampeonato).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; background-color: #dc3545; height: 100%;"></div>
                                </div>
                            </div>
                        </td>

                        <!-- Coluna 3: Saldo (Compacto para não empurrar a barra) -->
                        <td class="text-end" style="min-width: 60px;">
                            <div class="card shadow-sm border-0 @(clube.Saldo >= 0 ? "bg-success" : "bg-danger") text-white text-center py-1 px-1"
                                 style="width: 55px; border-radius: 6px; margin-left: auto;">
                                <small style="font-size: 0.5rem; opacity: 0.8; display: block;">SALDO</small>
                                <div class="fw-bold" style="font-size: 0.8rem;">
                                    @(clube.Saldo > 0 ? "+" : "")@clube.Saldo
                                </div>
                            </div>
                        </td>
                    </tr>
 <!-- Detalhes Expansíveis (Ajuste de Amarelos e Vermelhos) -->
                    @if (clube.ExibirDetalhes)
                        {
                    <tr class="bg-light">
                        <td colspan="3" class="p-2 border-0">
                            <div class="animate__animated animate__fadeInDown animate__faster">
                                <!-- Mudamos para flex-column no mobile para não esmagar -->
                                <div class="d-flex flex-column flex-sm-row justify-content-around align-items-center gap-3">

                                    <div class="text-center">
                                        <small class="text-muted d-block mb-0">👟 Artilheiro</small>
                                        <span class="fw-bold small">@clube.MelhorArtilheiro</span>
                                        <span class="badge rounded-pill bg-success ms-1">@clube.GolsArtilheiro</span>
                                    </div>

                                    <div class="d-none d-sm-block" style="width: 1px; height: 30px; background-color: #dee2e6;"></div>

                                    <!-- Cartões com gap maior para mobile -->
                                    <div class="d-flex gap-5 gap-sm-4">
                                        <div class="text-center">
                                            <small class="text-muted d-block mb-1">Amarelos</small>
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-id-card text-warning me-1"></i>
                                                <span class="fw-bold">@clube.Amarelos</span>
                                            </div>
                                        </div>
                                        <div class="text-center">
                                            <small class="text-muted d-block mb-1">Vermelhos</small>
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-id-card text-danger me-1"></i>
                                                <span class="fw-bold">@clube.Vermelhos</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
}}
                </tbody>

            </table>
        </div>
    }
</div>


@code {

    private List<EstatisticaClube> listaRanking = new();
    private int totalGolsCampeonato = 0;
    private int maxGols = 0; // <--- ADICIONE ESTA LINHA AQUI
    private int anoSelecionado = 2024;
    private bool carregando = true;
    private string temporadasDisponiveisStr = ""; // Variável para o Banner
    private string tituloPagina = "";

    private List<ArtilheiroGeral> topArtilheiros = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Busca os anos disponíveis apenas UMA VEZ ao iniciar
        await CarregarTemporadasDisponiveis();

        //=> await CarregarDados();
        await CarregarDados();
    }


    private async Task CarregarDados()
    {
        carregando = true;
        // RESETAR DADOS ANTIGOS ANTES DE BUSCAR OS NOVOS
        topArtilheiros = new();
        listaRanking = new();
        totalGolsCampeonato = 0;
        try
        {
            var client = ClientFactory.CreateClient("BrasileiraoAPI");
            var jogos = await client.GetFromJsonAsync<List<Jogo>>($"api/jogos?ano={anoSelecionado}");
            var eventos = await client.GetFromJsonAsync<List<EventosJogos>>($"api/jogos/eventos-temporada/{anoSelecionado}");

            if (jogos != null && jogos.Any())
            {
                totalGolsCampeonato = jogos.Sum(j => j.GolsMandante + j.GolsVisitante);

                var desempenhoCasa = jogos.GroupBy(j => j.TimeMandante).Select(g => new
                {
                    Nome = g.Key,
                    F = g.Sum(x => x.GolsMandante),
                    S = g.Sum(x => x.GolsVisitante)
                });

                var desempenhoFora = jogos.GroupBy(j => j.TimeVisitante).Select(g => new
                {
                    Nome = g.Key,
                    F = g.Sum(x => x.GolsVisitante),
                    S = g.Sum(x => x.GolsMandante)
                });

                listaRanking = desempenhoCasa.Concat(desempenhoFora)
                    .GroupBy(x => x.Nome)
                    .Select(g => new EstatisticaClube
                    {
                        Nome = g.Key,
                        GolsFeitos = g.Sum(x => x.F),
                        GolsSofridos = g.Sum(x => x.S)
                    })
                    .OrderByDescending(x => x.GolsFeitos)
                    .ToList();

                foreach (var clube in listaRanking)
                {
                    var evClube = eventos.Where(e => e.TimeNome == clube.Nome).ToList();
                    clube.Amarelos = evClube.Count(e => e.Tipo == "Card" && e.Detalhe.Contains("Yellow"));
                    clube.Vermelhos = evClube.Count(e => e.Tipo == "Card" && e.Detalhe.Contains("Red"));

                    var artilheiro = evClube.Where(e => e.Tipo == "Goal")
                                            .GroupBy(e => e.Jogador)
                                            .OrderByDescending(g => g.Count())
                                            .FirstOrDefault();

                    if (artilheiro != null)
                    {
                        clube.MelhorArtilheiro = artilheiro.Key;
                        clube.GolsArtilheiro = artilheiro.Count();
                    }
                }

                for (int i = 0; i < listaRanking.Count; i++)
                {
                    listaRanking[i].PosicaoAtaque = i + 1;
                }

                // --- INSERÇÃO DO TOP 5 ARTILHEIROS GERAL ---
                if (eventos != null && eventos.Any())
                {
                    topArtilheiros = eventos
                        .Where(e => e.Tipo == "Goal")
                        .GroupBy(e => new { e.Jogador, e.TimeNome })
                        .Select(g => new ArtilheiroGeral
                        {
                            Nome = g.Key.Jogador,
                            Time = g.Key.TimeNome,
                            Gols = g.Count()
                        })
                        .OrderByDescending(g => g.Gols)
                        .Take(5)
                        .ToList();
                }

                if (listaRanking.Any())
                {
                    maxGols = listaRanking.Max(x => Math.Max(x.GolsFeitos, x.GolsSofridos));
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro ao processar estatísticas: " + ex.Message);
        }
        finally
        {
            carregando = false;
        }
    }




    private double CalcularPorcentagem(int gols) =>
    totalGolsCampeonato > 0 ? (double)gols / totalGolsCampeonato * 100 * 5 : 0; // x5 para dar volume visual

    private async Task MudarAno(ChangeEventArgs e)
    {
        anoSelecionado = int.Parse(e.Value.ToString());
        await CarregarDados();
    }

    private void Ordenar(string campo)
    {
        if (campo == "Nome") listaRanking = listaRanking.OrderBy(x => x.Nome).ToList();
        else if (campo == "Gols") listaRanking = listaRanking.OrderByDescending(x => x.GolsFeitos).ToList();
        else if (campo == "Saldo") listaRanking = listaRanking.OrderByDescending(x => x.Saldo).ToList();
    }

    private async Task CarregarTemporadasDisponiveis()
    {
        try
        {
            var client = ClientFactory.CreateClient("BrasileiraoAPI");
            // Chamamos o endpoint sem o filtro de ano para pegar a base toda
            var todosOsJogos = await client.GetFromJsonAsync<List<Jogo>>("api/jogos");

            if (todosOsJogos != null)
            {
                temporadasDisponiveisStr = string.Join(" • ",
                    todosOsJogos.Select(j => j.DataJogo.Year)
                                .Distinct()
                                .OrderBy(y => y));
            }
        }
        catch { /* log erro */ }
    }

}

