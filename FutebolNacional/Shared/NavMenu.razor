<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href="">FutebolNacional</a>
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<!-- Removido o @onclick daqui para evitar o conflito de bolha -->
<div class="@NavMenuCssClass">
    <nav class="flex-column">
        <!-- Item Home -->
        <div class="nav-item px-3 text-white">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="FecharTudo">
                <span class="oi oi-home me-2" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3 custom-dropdown">
            <a class="nav-link dropdown-toggle btn btn-link w-100 text-start border-0 text-white shadow-none d-flex align-items-center"
               role="button"
               @onclick="ToggleSubMenu"
               @onclick:stopPropagation>
                <!-- Importante: Impede fechar o menu principal ao abrir o sub -->
                <span class="oi oi-list-rich me-2" aria-hidden="true"></span>
                <span>Brasileirão</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-dark shadow-none border-0 submenu-lista @(expandSubMenu ? "menu-aberto" : "")">
                <li>
                    <NavLink class="dropdown-item" href="jogos" @onclick="FecharTudo">
                        <i class="fas fa-calendar-alt me-2"></i> Jogos
                    </NavLink>
                </li>
                <li>
                    <NavLink class="dropdown-item" href="classificacao" @onclick="FecharTudo">
                        <i class="fas fa-chart-bar me-2"></i> Classificação
                    </NavLink>
                </li>
                <li>
                    <NavLink class="dropdown-item" href="estatisticas" @onclick="FecharTudo">
                        <i class="fas fa-chart-bar me-2"></i> Estatísticas
                    </NavLink>
                </li>
            </ul>
        </div>
    </nav>
</div>

@code { private bool collapseNavMenu = true;
            private bool expandSubMenu = false;

            private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

            private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

            private void ToggleSubMenu() => expandSubMenu = !expandSubMenu;

            // Esta função garante que tudo feche ao navegar
            private void FecharTudo()
            {
                collapseNavMenu = true;
                expandSubMenu = false;
            } }
